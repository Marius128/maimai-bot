# MySQL（生产环境不要使用 root 作为应用账号）
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_root_password
DB_USERNAME=maimai
DB_PASSWORD=replace_with_a_long_random_app_password

# 必须与 SnowLuma 的 OneBot WebSocket accessToken 完全一致
ONEBOT_ACCESS_TOKEN=replace_after_snowluma_login

# SnowLuma noVNC 远程桌面密码，请设置为新的强密码
VNC_PASSWD=replace_with_a_strong_vnc_password

# 生成方式：openssl rand -base64 32
# 配置后不可随意更换，否则数据库中的旧授权将无法解密
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# 水鱼 OAuth 应用（开发者控制台生成，client_secret 不得提交到 Git）
DIVING_FISH_OAUTH_CLIENT_ID=replace_with_diving_fish_client_id
DIVING_FISH_OAUTH_CLIENT_SECRET=replace_with_diving_fish_client_secret

# 落雪开发者 API 与 OAuth 应用
LXNS_API_KEY=replace_with_lxns_api_key
LXNS_OAUTH_CLIENT_ID=replace_with_lxns_oauth_client_id
LXNS_OAUTH_CLIENT_SECRET=replace_with_lxns_oauth_client_secret
LXNS_OAUTH_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# 建议正式上线后改成明确版本，不要长期跟随 latest
SNOWLUMA_IMAGE=motricseven7/snowluma:latest
